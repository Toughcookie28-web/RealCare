{
  "title": "MediGenius Overview",
  "uid": "medigenius-overview",
  "schemaVersion": 36,
  "version": 3,
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP Request Rate",
      "targets": [
        {
          "expr": "rate(medigenius_http_requests_total[1m])",
          "legendFormat": "{{method}} {{path}}"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "HTTP 5xx Error Rate",
      "targets": [
        {
          "expr": "rate(medigenius_http_requests_total{status=~\"5..\"}[5m])",
          "legendFormat": "{{method}} {{path}}"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "Request Latency P95 (seconds)",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(medigenius_http_request_latency_seconds_bucket[5m]))",
          "legendFormat": "P95 {{path}}"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
    },
    {
      "type": "timeseries",
      "title": "Request Latency P99 (seconds)",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(medigenius_http_request_latency_seconds_bucket[5m]))",
          "legendFormat": "P99 {{path}}"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
    },
    {
      "type": "timeseries",
      "title": "Node Latency (ms)",
      "targets": [
        {
          "expr": "medigenius_node_latency_ms_sum / medigenius_node_latency_ms_count",
          "legendFormat": "{{node}}"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}
    },
    {
      "type": "timeseries",
      "title": "Node Errors",
      "targets": [
        {
          "expr": "rate(medigenius_node_errors_total[5m])",
          "legendFormat": "{{node}}"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}
    },
    {
      "type": "timeseries",
      "title": "Semantic Cache Hit/Miss Rate",
      "targets": [
        {
          "expr": "rate(medigenius_semantic_cache_hits_total[5m])",
          "legendFormat": "hits"
        },
        {
          "expr": "rate(medigenius_semantic_cache_misses_total[5m])",
          "legendFormat": "misses"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24}
    },
    {
      "type": "gauge",
      "title": "Cache Hit Ratio",
      "targets": [
        {
          "expr": "medigenius_semantic_cache_hits_total / (medigenius_semantic_cache_hits_total + medigenius_semantic_cache_misses_total)",
          "legendFormat": "hit ratio"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24}
    },
    {
      "type": "timeseries",
      "title": "Tool Cache Hit/Miss Rate (by tool)",
      "targets": [
        {
          "expr": "rate(medigenius_tool_cache_hits_total[5m])",
          "legendFormat": "{{tool}} hits"
        },
        {
          "expr": "rate(medigenius_tool_cache_misses_total[5m])",
          "legendFormat": "{{tool}} misses"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32}
    },
    {
      "type": "gauge",
      "title": "Tool Cache Hit Ratio (by tool)",
      "targets": [
        {
          "expr": "medigenius_tool_cache_hits_total / (medigenius_tool_cache_hits_total + medigenius_tool_cache_misses_total)",
          "legendFormat": "{{tool}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "steps": [
              {"color": "red", "value": 0},
              {"color": "yellow", "value": 0.3},
              {"color": "green", "value": 0.6}
            ]
          }
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32}
    },
    {
      "type": "stat",
      "title": "Redis Status",
      "targets": [
        {
          "expr": "medigenius_redis_up",
          "legendFormat": "Redis"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}}},
            {"type": "value", "options": {"1": {"text": "UP", "color": "green"}}}
          ]
        }
      },
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 40}
    },
    {
      "type": "timeseries",
      "title": "Tracked Retrieval Recall@5",
      "datasource": {"type": "postgres", "uid": "grafana-postgres-benchmark"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "postgres", "uid": "grafana-postgres-benchmark"},
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT r.created_at AS \"time\", m.metric_value AS value, r.mode AS metric FROM eval_run_metrics m JOIN eval_runs r ON r.run_id = m.run_id WHERE r.eval_type = 'retrieval' AND m.metric_name = 'recall@5' ORDER BY 1, 3"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 44}
    },
    {
      "type": "timeseries",
      "title": "Tracked Retrieval MRR@5",
      "datasource": {"type": "postgres", "uid": "grafana-postgres-benchmark"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "postgres", "uid": "grafana-postgres-benchmark"},
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT r.created_at AS \"time\", m.metric_value AS value, r.mode AS metric FROM eval_run_metrics m JOIN eval_runs r ON r.run_id = m.run_id WHERE r.eval_type = 'retrieval' AND m.metric_name = 'mrr@5' ORDER BY 1, 3"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 44}
    },
    {
      "type": "timeseries",
      "title": "Tracked RAGAS Context Precision",
      "datasource": {"type": "postgres", "uid": "grafana-postgres-benchmark"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "postgres", "uid": "grafana-postgres-benchmark"},
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT r.created_at AS \"time\", m.metric_value AS value, r.mode AS metric FROM eval_run_metrics m JOIN eval_runs r ON r.run_id = m.run_id WHERE r.eval_type = 'ragas' AND m.metric_name = 'context_precision' ORDER BY 1, 3"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 52}
    },
    {
      "type": "timeseries",
      "title": "Tracked RAGAS Faithfulness",
      "datasource": {"type": "postgres", "uid": "grafana-postgres-benchmark"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "postgres", "uid": "grafana-postgres-benchmark"},
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT r.created_at AS \"time\", m.metric_value AS value, r.mode AS metric FROM eval_run_metrics m JOIN eval_runs r ON r.run_id = m.run_id WHERE r.eval_type = 'ragas' AND m.metric_name = 'faithfulness' ORDER BY 1, 3"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 52}
    },
    {
      "type": "table",
      "title": "Recent Benchmark Runs",
      "datasource": {"type": "postgres", "uid": "grafana-postgres-benchmark"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "postgres", "uid": "grafana-postgres-benchmark"},
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT r.created_at, r.eval_type, r.mode, r.split, r.sample_count, r.git_sha, COALESCE(r.judge_model, '') AS judge_model, r.snapshot_path FROM eval_runs r ORDER BY r.created_at DESC LIMIT 20"
        }
      ],
      "options": {
        "showHeader": true
      },
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 60}
    },
    {
      "type": "timeseries",
      "title": "Live Judged Request Rate",
      "targets": [
        {
          "expr": "rate(medigenius_live_judged_requests_total[5m])",
          "legendFormat": "{{route}}"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 70}
    },
    {
      "type": "timeseries",
      "title": "Live Judge Failure Rate",
      "targets": [
        {
          "expr": "rate(medigenius_live_judge_failures_total[5m])",
          "legendFormat": "{{route}}"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 70}
    },
    {
      "type": "timeseries",
      "title": "Live Answer Relevance (avg 5m)",
      "targets": [
        {
          "expr": "rate(medigenius_live_answer_relevance_score_sum[5m]) / clamp_min(rate(medigenius_live_answer_relevance_score_count[5m]), 1e-9)",
          "legendFormat": "{{route}}"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 78}
    },
    {
      "type": "timeseries",
      "title": "Live Groundedness (avg 5m)",
      "targets": [
        {
          "expr": "rate(medigenius_live_groundedness_score_sum[5m]) / clamp_min(rate(medigenius_live_groundedness_score_count[5m]), 1e-9)",
          "legendFormat": "{{route}}"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 78}
    },
    {
      "type": "timeseries",
      "title": "Live Context Precision Proxy (avg 5m)",
      "targets": [
        {
          "expr": "rate(medigenius_live_context_precision_proxy_sum[5m]) / clamp_min(rate(medigenius_live_context_precision_proxy_count[5m]), 1e-9)",
          "legendFormat": "{{route}}"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 86}
    },
    {
      "type": "timeseries",
      "title": "Live Context Coverage Proxy (avg 5m)",
      "targets": [
        {
          "expr": "rate(medigenius_live_context_coverage_proxy_sum[5m]) / clamp_min(rate(medigenius_live_context_coverage_proxy_count[5m]), 1e-9)",
          "legendFormat": "{{route}}"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 86}
    },
    {
      "type": "timeseries",
      "title": "Live Judge Latency P95 (ms)",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(medigenius_live_judge_latency_ms_bucket[5m]))",
          "legendFormat": "P95 {{route}}"
        }
      ],
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 94}
    }
  ]
}
