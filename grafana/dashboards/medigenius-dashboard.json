          "expr": "medigenius_redis_up",
          "legendFormat": "Redis",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 40
      }
    },
    {
      "type": "table",
      "title": "Recent Benchmark Runs",
      "datasource": {
        "type": "postgres",
        "uid": "grafana-postgres-benchmark"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "grafana-postgres-benchmark"
          },
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT r.created_at, r.eval_type, r.mode, r.split, r.sample_count, r.git_sha, COALESCE(r.judge_model, '') AS judge_model, r.snapshot_path FROM eval_runs r ORDER BY r.created_at DESC LIMIT 20"
        }
      ],
      "options": {
        "showHeader": true
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 60
      }
    },
