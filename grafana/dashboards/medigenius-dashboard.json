    {
      "title": "Tool Cache Hit Ratio (by tool)",
      "type": "gauge",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "medigenius_tool_cache_hits_total / clamp_min(medigenius_tool_cache_hits_total + medigenius_tool_cache_misses_total, 1)",
