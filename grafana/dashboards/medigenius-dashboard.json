{
  "title": "MediGenius Overview",
  "uid": "medigenius-overview",
  "schemaVersion": 36,
  "version": 4,
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP Request Rate",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(medigenius_http_requests_total[1m])",
          "legendFormat": "{{method}} {{path}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "HTTP 5xx Error Rate",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(medigenius_http_requests_total{status=~\"5..\"}[5m])",
          "legendFormat": "{{method}} {{path}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Request Latency P95 (seconds)",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, rate(medigenius_http_request_latency_seconds_bucket[5m]))",
          "legendFormat": "P95 {{path}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Request Latency P99 (seconds)",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, rate(medigenius_http_request_latency_seconds_bucket[5m]))",
          "legendFormat": "P99 {{path}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      }
    },
    {
      "type": "bargauge",
      "title": "Node Latency (ms) — avg per node",
      "description": "Average latency per pipeline node. Uses instant cumulative sum/count to avoid NaN from short rate windows.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg by (node)(medigenius_node_latency_ms_sum / medigenius_node_latency_ms_count)",
          "legendFormat": "{{node}}",
          "instant": true,
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "options": {
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 500},
              {"color": "red", "value": 2000}
            ]
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Node Errors",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(medigenius_node_errors_total[5m])",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      }
    },
    {
      "type": "timeseries",
      "title": "Semantic Cache Hit/Miss Rate",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(medigenius_semantic_cache_hits_total[5m])",
          "legendFormat": "hits",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(medigenius_semantic_cache_misses_total[5m])",
          "legendFormat": "misses",
          "refId": "B"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      }
    },
    {
      "type": "gauge",
      "title": "Cache Hit Ratio",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "medigenius_semantic_cache_hits_total / (medigenius_semantic_cache_hits_total + medigenius_semantic_cache_misses_total)",
          "legendFormat": "hit ratio",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      }
    },
    {
      "type": "timeseries",
      "title": "Tool Cache Hit/Miss Rate (by tool)",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(medigenius_tool_cache_hits_total[5m])",
          "legendFormat": "{{tool}} hits",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(medigenius_tool_cache_misses_total[5m])",
          "legendFormat": "{{tool}} misses",
          "refId": "B"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      }
    },
    {
      "type": "gauge",
      "title": "Tool Cache Hit Ratio (by tool)",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "medigenius_tool_cache_hits_total / (medigenius_tool_cache_hits_total + medigenius_tool_cache_misses_total)",
          "legendFormat": "{{tool}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 0.3
              },
              {
                "color": "green",
                "value": 0.6
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      }
    },
    {
      "type": "stat",
      "title": "Redis Status",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "medigenius_redis_up",
          "legendFormat": "Redis",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 40
      }
    },
    {
      "type": "timeseries",
      "title": "Tracked Retrieval Recall@5",
      "datasource": {
        "type": "postgres",
        "uid": "grafana-postgres-benchmark"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "grafana-postgres-benchmark"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT r.created_at AS \"time\", m.metric_value AS value, r.mode AS metric FROM eval_run_metrics m JOIN eval_runs r ON r.run_id = m.run_id WHERE r.eval_type = 'retrieval' AND m.metric_name = 'recall@5' ORDER BY 1, 3"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 44
      }
    },
    {
      "type": "timeseries",
      "title": "Tracked RAGAS Context Precision",
      "datasource": {
        "type": "postgres",
        "uid": "grafana-postgres-benchmark"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "grafana-postgres-benchmark"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT r.created_at AS \"time\", m.metric_value AS value, r.mode AS metric FROM eval_run_metrics m JOIN eval_runs r ON r.run_id = m.run_id WHERE r.eval_type = 'ragas' AND m.metric_name = 'context_precision' ORDER BY 1, 3"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 44
      }
    },
    {
      "type": "timeseries",
      "title": "Tracked RAGAS Faithfulness",
      "datasource": {
        "type": "postgres",
        "uid": "grafana-postgres-benchmark"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "grafana-postgres-benchmark"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT r.created_at AS \"time\", m.metric_value AS value, r.mode AS metric FROM eval_run_metrics m JOIN eval_runs r ON r.run_id = m.run_id WHERE r.eval_type = 'ragas' AND m.metric_name = 'faithfulness' ORDER BY 1, 3"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 52
      }
    },
    {
      "type": "table",
      "title": "Recent Benchmark Runs",
      "datasource": {
        "type": "postgres",
        "uid": "grafana-postgres-benchmark"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "grafana-postgres-benchmark"
          },
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT r.created_at, r.eval_type, r.mode, r.split, r.sample_count, r.git_sha, COALESCE(r.judge_model, '') AS judge_model, r.snapshot_path FROM eval_runs r ORDER BY r.created_at DESC LIMIT 20"
        }
      ],
      "options": {
        "showHeader": true
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 60
      }
    },
    {
      "type": "timeseries",
      "title": "Live Judged Request Rate",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(medigenius_live_judged_requests_total[5m])",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 70
      }
    },
    {
      "type": "timeseries",
      "title": "Live Judge Failure Rate",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(medigenius_live_judge_failures_total[5m])",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 70
      }
    },
    {
      "type": "timeseries",
      "title": "Live Answer Relevance (avg 5m)",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(medigenius_live_answer_relevance_score_sum[5m]) / clamp_min(rate(medigenius_live_answer_relevance_score_count[5m]), 1e-9)",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 78
      }
    },
    {
      "type": "timeseries",
      "title": "Live Groundedness (avg 5m)",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(medigenius_live_groundedness_score_sum[5m]) / clamp_min(rate(medigenius_live_groundedness_score_count[5m]), 1e-9)",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 78
      }
    },
    {
      "type": "timeseries",
      "title": "Live Context Precision Proxy (avg 5m)",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(medigenius_live_context_precision_proxy_sum[5m]) / clamp_min(rate(medigenius_live_context_precision_proxy_count[5m]), 1e-9)",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 86
      }
    },
    {
      "type": "timeseries",
      "title": "Live Context Coverage Proxy (avg 5m)",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(medigenius_live_context_coverage_proxy_sum[5m]) / clamp_min(rate(medigenius_live_context_coverage_proxy_count[5m]), 1e-9)",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 86
      }
    },
    {
      "type": "timeseries",
      "title": "Live Judge Latency P95 (ms)",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, rate(medigenius_live_judge_latency_ms_bucket[5m]))",
          "legendFormat": "P95 {{route}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 94
      }
    },
    {
      "type": "piechart",
      "title": "Route Distribution",
      "description": "Distribution of pipeline routes (vector, chitchat, memory, clarify, etc.) over the selected time range",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 102
      },
      "options": {
        "pieType": "pie",
        "displayLabels": [
          "name",
          "percent"
        ],
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (route) (increase(medigenius_route_total[1h]))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Intent Confidence",
      "description": "Median and P10 intent confidence score from the query rewriter (lower = more ambiguous queries)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 102
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum(rate(medigenius_intent_confidence_bucket[5m])) by (le))",
          "legendFormat": "P50 confidence",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.1, sum(rate(medigenius_intent_confidence_bucket[5m])) by (le))",
          "legendFormat": "P10 confidence (most ambiguous)",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Reflection Grounding Score",
      "description": "P50 and P10 grounding score from the reflection agent (fraction of answer claims traceable to source chunks; lower = potential hallucination)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 102
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum(rate(medigenius_reflection_grounding_score_bucket[5m])) by (le))",
          "legendFormat": "P50 grounding",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.1, sum(rate(medigenius_reflection_grounding_score_bucket[5m])) by (le))",
          "legendFormat": "P10 grounding (worst)",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Clarification Rate",
      "description": "Rate of queries triggering a clarification request (intent_confidence < 0.4)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 110
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "increase(medigenius_clarification_triggered_total[5m])",
          "legendFormat": "Clarification triggers",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "SLO \u2014 Node Latency P95 < 2000ms",
      "description": "SLO: 95th-percentile node latency must stay below 2000ms. Green = meeting SLO.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 110
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1500
              },
              {
                "color": "red",
                "value": 2000
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(rate(medigenius_node_latency_ms_bucket[5m])) by (le))",
          "legendFormat": "P95 latency",
          "refId": "A"
        }
      ]
    },
    {
      "type": "traces",
      "title": "Pipeline Trace Explorer \u2014 click any trace to see node waterfall",
      "description": "Shows recent pipeline.request traces from Tempo. Each trace contains child spans for every node (query_rewriter, planner, retriever, executor, reflection) with their attributes (optimized_query, route, grounding_score, etc.).",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"medigenius\" && name=\"pipeline.request\"}",
          "refId": "A",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 120
      },
      "options": {
        "frameType": "TraceList"
      }
    }
  ]
}
