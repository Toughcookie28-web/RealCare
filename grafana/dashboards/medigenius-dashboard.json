    {
      "type": "traces",
      "title": "Pipeline Trace Explorer \u2014 click any trace to see node waterfall",
      "description": "Shows recent pipeline.request traces from Tempo. Each trace contains child spans for every node (query_rewriter, planner, retriever, executor, reflection) with their attributes (optimized_query, route, grounding_score, etc.).",
