# App
ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
SESSION_SECRET=
ALLOWED_ORIGINS=http://localhost:8000

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=medigenius
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/medigenius
PGVECTOR_ENABLED=true
# Set true in production to fail fast on DB startup errors
DATABASE_STRICT_MODE=false

# LLM providers
GROQ_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=
GOOGLE_API_KEY=
OPENAI_BASE_URL=

# Model config
# Providers: groq | openai
LLM_PRIMARY_PROVIDER=groq
LLM_FALLBACK_PROVIDER=groq
# Examples:
# - Groq models: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
# - OpenAI models: gpt-4o-mini, gpt-4o
# - OpenAI-compatible (Moonshot, etc.): set OPENAI_BASE_URL to that provider endpoint
LLM_PRIMARY_MODEL=moonshotai/kimi-k2-instruct-0905
LLM_FALLBACK_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200
# Embedding providers: local | gemini
# local = sentence-transformers on your machine
# gemini = API embeddings
EMBEDDING_PROVIDER=local
EMBEDDING_LOCAL_MODEL=Alibaba-NLP/gte-base-en-v1.5
# local strategy:
# - plain: always use model.encode(...)
# - asymmetric: prefer encode_query/encode_document when the model exposes them
EMBEDDING_LOCAL_STRATEGY=plain
EMBEDDING_LOCAL_TRUST_REMOTE_CODE=true
# Local host default for non-container runs.
# docker-compose overrides the container runtime cache root to /app/.cache/embeddings.
EMBEDDING_CACHE_DIR=/tmp/medigenius-embeddings
EMBEDDING_GEMINI_MODEL=gemini-embedding-001
EMBEDDING_ENABLE_BACKUP=false
EMBEDDING_DIM=768

# Reranking (Cohere cross-encoder)
# Sign up at https://dashboard.cohere.com/api-keys for a free API key
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v4.0-pro

# Redis (caching layer)
# Leave empty to use in-memory fallback (no Redis needed for local dev)
REDIS_URL=
# Default TTL for cached entries in seconds (86400 = 24 hours)
REDIS_CACHE_TTL=86400
# Redis working memory
# How long to retain rolling recent-turn memory for an active session
WORKING_MEMORY_RECENT_TURNS_TTL=43200
# How long to retain locked core session state (facts, intent, medical context)
WORKING_MEMORY_CORE_STATE_TTL=604800
# Maximum number of recent turn records kept per session in Redis
WORKING_MEMORY_RECENT_TURNS_MAX=12
# Live approximate RAG quality judging
LIVE_JUDGE_ENABLED=false
# Fraction of frontend requests to judge asynchronously (0.0-1.0)
LIVE_JUDGE_SAMPLING_RATIO=0.2

# Retrieval & policy
# Weight for dense (vector) vs sparse (BM25) in hybrid search (0.0-1.0)
HYBRID_DENSE_WEIGHT=0.7
TRUSTED_MEDICAL_DOMAINS=nih.gov,mayoclinic.org,who.int,cdc.gov,pubmed.ncbi.nlm.nih.gov
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_SIZE=5000
# Leave unset to use the safe default: disabled in development/local/test/eval,
# enabled in production-style environments.
SEMANTIC_CACHE_ENABLED=
# Bump this when you intentionally want to invalidate prior semantic cache entries.
SEMANTIC_CACHE_VERSION=executor-v1
BM25_K1=1.2
BM25_B=0.75
ROUTING_RAG_CONFIDENCE_THRESHOLD=0.12
ENABLE_HITL_INTERRUPTS=true
AUTO_INGEST_ON_STARTUP=false

# Chunking
CHUNK_TEXT_TARGET=400
CHUNK_TEXT_MAX=500
CHUNK_TEXT_OVERLAP=50
CHUNK_TABLE_MAX=450
# Set true to enrich chunks with LLM-generated summaries, keywords, and medical entities at ingest time.
# Requires a working LLM provider (Groq). Adds latency and cost to reindex.
ENRICH_CHUNKS_WITH_LLM=false

# Observability
OTEL_ENABLED=true
# Set to enable OTLP trace export (e.g., http://localhost:4317)
# OTEL_EXPORTER_OTLP_ENDPOINT=

# Grafana (docker-compose)
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin
